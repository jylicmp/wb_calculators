+class Qorb_GaoXiao(MultitermCalculator):
+    r"""Total Gao-Xiao orbital magnetic quadrupole moment density.
+
+    It sums the four terms CL + IMD + ME + QMD from Gao and Xiao,
+    Phys. Rev. B 98, 060402(R) (2018), Eq. (4).
+    """
+    def __init__(self, **kwargs):
+        super().__init__(**kwargs)
+        self.terms = [
+            Qorb_GaoXiao_CL(**kwargs),
+            Qorb_GaoXiao_IMD(**kwargs),
+            Qorb_GaoXiao_ME(**kwargs),
+            Qorb_GaoXiao_QMD(**kwargs),
+        ]
+class Beta_GaoXiao(Calculator):
+    r"""Intrinsic second-order thermoelectric beta tensor from Gao-Xiao Eq. (8).
+
+    The response convention is
+
+        J_a^(2) = beta_abd (partial_b T / T) (partial_d T / T),
+
+    with the symmetrized tensor
+
+        beta_abd = sum_n int[dk] 1/2 (eps_abc theta_cd^n + eps_adc theta_cb^n)
+                   (eps_n - mu)^2 (partial f_n / partial eps_n).
+
+    Note that partial f / partial eps is negative.  The virtual sum inside
+    theta_cd^n is over all m != n bands, independent of occupancy.
+    """
+
+    def __init__(self, Efermi, kBT=None, T_Kelvin=None, maxdE=10.0, constant_factor=1.0,
+                 use_factor=True, kwargs_formula=None, Emin=-np.inf, Emax=np.inf,
+                 k_resolved=False, **kwargs):
+        super().__init__(**kwargs)
+        self.Efermi = np.asarray(Efermi, dtype=float)
+        if self.Efermi.ndim != 1:
+            raise ValueError("Efermi must be a one-dimensional array")
+        if kBT is None:
+            if T_Kelvin is None:
+                raise ValueError("Please provide either kBT in eV or T_Kelvin in K")
+            kBT = float(T_Kelvin) * Boltzmann / elementary_charge
+        self.kBT = float(kBT)
+        if self.kBT <= 0.0:
+            raise ValueError("Beta_GaoXiao is a finite-temperature Fermi-surface quantity; kBT must be positive")
+        self.maxdE = float(maxdE)
+        self.constant_factor = constant_factor
+        self.use_factor = use_factor
+        self.kwargs_formula = {} if kwargs_formula is None else copy(kwargs_formula)
+        self.Emin = Emin
+        self.Emax = Emax
+        self.k_resolved = k_resolved
+        self.save_mode = kwargs.get("save_mode", getattr(self, "save_mode", "bin+txt"))
+        self.comment = (self.comment +
+                        f"\nFinite-temperature kernel: kBT = {self.kBT:.8g} eV, maxdE = {self.maxdE:g} kBT.")
+
+    @staticmethod
+    def _dfde(E_minus_mu, kBT):
+        """Return partial f(E,mu,T)/partial E, including its negative sign."""
+        x = np.asarray(E_minus_mu, dtype=float) / (2.0 * kBT)
+        res = np.zeros_like(x, dtype=float)
+        mask = np.abs(x) < 350.0
+        res[mask] = -0.25 / kBT / (np.cosh(x[mask]) ** 2)
+        return res
+
+    def __call__(self, data_K):
+        formula = frml.Beta_GaoXiao_ThetaSym(data_K, **self.kwargs_formula)
+        ndim = formula.ndim
+        NB = data_K.num_wann
+
+        if self.k_resolved:
+            nk_result = data_K.nk
+            def ik_to_result(ik):
+                return ik
+        else:
+            nk_result = 1
+            def ik_to_result(_):
+                return 0
+
+        emin = float(np.min(self.Efermi) - self.maxdE * self.kBT)
+        emax = float(np.max(self.Efermi) + self.maxdE * self.kBT)
+        band_groups = data_K.get_bands_in_range_groups(
+            emin, emax,
+            degen_thresh=self.degen_thresh,
+            degen_Kramers=self.degen_Kramers,
+            sea=False,
+            Emin=self.Emin,
+            Emax=self.Emax,
+        )
+
+        shape = (3,) * ndim
+        restot = np.zeros((nk_result, self.Efermi.shape[0]) + shape, dtype=float)
+        for ik, groups in enumerate(band_groups):
+            for n, E in sorted(groups.items()):
+                inn = np.arange(n[0], n[1])
+                out = np.concatenate((np.arange(0, n[0]), np.arange(n[1], NB)))
+                if len(out) == 0:
+                    continue
+                value = formula.trace(ik, inn, out)
+                dE = float(E) - self.Efermi
+                kernel = (dE ** 2) * self._dfde(dE, self.kBT)
+                restot[ik_to_result(ik)] += cached_einsum("e,...->e...", kernel, value)
+
+        restot /= data_K.cell_volume
+        if not self.k_resolved:
+            restot /= data_K.nk
+        if self.use_factor:
+            restot *= self.constant_factor
+        else:
+            restot *= np.sign(self.constant_factor)
+
+        if self.k_resolved:
+            return K__Result([restot], transformTR=formula.transformTR, transformInv=formula.transformInv,
+                             rank=restot.ndim - 2,
+                             other_properties=dict(comment=self.comment, efermi=self.Efermi, kBT=self.kBT))
+        return EnergyResult(self.Efermi, restot[0], transformTR=formula.transformTR,
+                            transformInv=formula.transformInv, smoothers=[None], comment=self.comment,
+                            save_mode=self.save_mode)
+
