+def _gx_levi_civita():
+    eps = np.zeros((3, 3, 3), dtype=int)
+    eps[0, 1, 2] = eps[1, 2, 0] = eps[2, 0, 1] = 1
+    eps[1, 0, 2] = eps[2, 1, 0] = eps[0, 2, 1] = -1
+    return eps
+
+
+_EPS_GX = _gx_levi_civita()
