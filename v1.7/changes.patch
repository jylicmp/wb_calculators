+class Qorb_QMD(StaticCalculator):
+    """Quantum geometry contribution to orbital magnetic quadrupole moment per unit cell
+    """
+    def __init__(self, **kwargs):
+        self.Formula = frml.Qorb_QMDen
+        self.fder = 0
+        super().__init__(**kwargs)
+        self.dg = Qorb_dG(**kwargs)
+        
+    def __call__(self, data_K):
+        res = super().__call__(data_K)
+        dg_mu = self.dg(data_K).mul_array(self.Efermi, axes=0)
+        res.add((-1) * dg_mu)
+        return res * data_K.cell_volume
